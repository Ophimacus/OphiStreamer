<Window x:Class="OphiStreamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OphiStreamer" Width="760" Height="780" MinWidth="640" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
    <Grid Background="{StaticResource WindowBg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Grid x:Name="TitleBar" Background="#0E141B">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
          <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="14" VerticalAlignment="Center"/>
          <TextBlock Text="OphiStreamer" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="MinBtn" Style="{StaticResource Chrome}" Content="&#xE921;" ToolTip="Minimize"/>
          <Button x:Name="CloseBtn" Style="{StaticResource Chrome}" Content="&#xE8BB;" ToolTip="Hide to tray"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border BorderBrush="#1A2230" BorderThickness="0,0,1,0" Padding="8,16">
          <StackPanel>
            <TextBlock Text="OPHISTREAMER" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" Margin="12,0,0,14"/>
            <RadioButton x:Name="NavStream" GroupName="nav" Style="{StaticResource Nav}" IsChecked="True">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Stream"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavLog" GroupName="nav" Style="{StaticResource Nav}">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Connection log"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource Nav}">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Settings"/></StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>

        <!-- Stream page -->
        <Grid x:Name="StreamPage" Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="18,16,18,8">
              <Border Background="{StaticResource HeroBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="18">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock x:Name="HeroTitle" Text="Gaming mode off" FontSize="22" FontWeight="SemiBold"/>
                      <TextBlock x:Name="HeroSub" Text="Starting..." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton x:Name="GamingSwitch" Grid.Column="1" Style="{StaticResource BigSwitch}" VerticalAlignment="Center" ToolTip="Gaming mode"/>
                  </Grid>
                  <UniformGrid x:Name="Tiles" Columns="4" Margin="0,16,0,0">
                    <Border Background="#47000000" CornerRadius="6" Padding="0,10" Margin="0,0,6,0">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TileLatency" Text="-" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="LATENCY" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <Border Background="#47000000" CornerRadius="6" Padding="0,10" Margin="3,0">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TileBand" Text="-" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="BAND" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <Border Background="#47000000" CornerRadius="6" Padding="0,10" Margin="3,0">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TileSignal" Text="-" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="SIGNAL" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <Border Background="#47000000" CornerRadius="6" Padding="0,10" Margin="6,0,0,0">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TileSpikes" Text="-" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="SPIKES / MIN" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                </StackPanel>
              </Border>

              <TextBlock Style="{StaticResource Caption}" Text="CONNECT YOUR PHONE"/>
              <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                  <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="16,12">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Phone hotspot" FontSize="14"/>
                        <TextBlock x:Name="PhoneSsidText" Text="Not set" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Button x:Name="UseCurrentBtn" Grid.Column="1" Style="{StaticResource Secondary}" Content="Use current network"/>
                    </Grid>
                  </Border>
                  <Border Padding="16,12">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Add this PC in OphiStreamer / Artemis" FontSize="14"/>
                        <TextBlock Text="Only needed if the phone doesn't find it by itself" FontSize="12" Foreground="{StaticResource Muted}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LaptopIpText" Text="-" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="CopyIpBtn" Style="{StaticResource Secondary}" Content="Copy"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <TextBlock Style="{StaticResource Caption}" Text="OPTIMIZATIONS"/>
              <Border Style="{StaticResource CardBorder}">
                <StackPanel x:Name="ChecksPanel"/>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="1" Margin="18,10,18,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
            <Button x:Name="OpenLogsBtn" Style="{StaticResource Secondary}" Height="48" Content="Open log folder"/>
            <Button x:Name="MainBtn" Grid.Column="2" Style="{StaticResource Primary}" Content="START GAMING MODE"/>
          </Grid>
        </Grid>

        <!-- Connection log page -->
        <Grid x:Name="LogPage" Grid.Column="1" Visibility="Collapsed" Margin="18,16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Connection log" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Today's Gaming mode changes, drops and reconnects." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,3,0,12"/>
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12,8">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="LogPanel"/>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- Settings page -->
        <StackPanel x:Name="SettingsPage" Grid.Column="1" Visibility="Collapsed" Margin="18,16">
          <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Style="{StaticResource Caption}" Text="PHONE"/>
          <Border Style="{StaticResource CardBorder}" Padding="16,12">
            <StackPanel>
              <TextBlock Text="Phone hotspot name" FontSize="14"/>
              <TextBlock Text="Exactly as shown on the phone. Joining it turns Gaming mode on." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,8"/>
              <TextBox x:Name="SsidBox"/>
              <CheckBox x:Name="AutoBox" Style="{StaticResource Check}" Content="Turn on Gaming mode automatically on the phone hotspot" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Caption}" Text="SCREEN"/>
          <Border Style="{StaticResource CardBorder}" Padding="16,12">
            <StackPanel>
              <CheckBox x:Name="PhoneOnlyBox" Style="{StaticResource Check}" Content="Show the game only on my phone"/>
              <TextBlock Text="Turns the laptop screen off while the phone streams, like Win+P &gt; Second screen only. It comes back by itself when the phone disconnects, and when OphiStreamer closes." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="28,4,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Caption}" Text="APOLLO (FOR PHONE PAIRING AND REPAIR)"/>
          <Border Style="{StaticResource CardBorder}" Padding="16,12">
            <StackPanel>
              <TextBlock Text="The login you use for Apollo's web panel (https://localhost:47990). Stored encrypted for your Windows account." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock Text="Username" FontSize="13"/>
              <TextBox x:Name="ApolloUserBox" Margin="0,4,0,8"/>
              <TextBlock Text="Password" FontSize="13"/>
              <PasswordBox x:Name="ApolloPassBox" Margin="0,4,0,10" Background="#0F151D" Foreground="#DCDEDF" BorderBrush="#26313E" Padding="8,6" FontSize="13"/>
              <Button x:Name="TestApolloBtn" Style="{StaticResource Secondary}" Content="Save and test login" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Caption}" Text="APP"/>
          <Border Style="{StaticResource CardBorder}" Padding="16,12">
            <CheckBox x:Name="StartupBox" Style="{StaticResource Check}" Content="Start OphiStreamer with Windows (in the tray)"/>
          </Border>
          <Button x:Name="SaveBtn" Style="{StaticResource Primary}" Content="SAVE" Margin="0,18,0,0" Width="200" HorizontalAlignment="Left"/>
          <TextBlock x:Name="SavedText" Foreground="#59BF40" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
